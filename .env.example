# Copy to .env.local for development. Set the same variables in your host (e.g. Vercel → Settings → Environment Variables).
# Everything is optional in development: without it, the site still runs and logs submissions to the terminal.

# Public site URL, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://itzmanisha.com

# ---- Where form submissions go (registrations, applications, enquiries, assessments, orders, payments)
# A Google Apps Script web app URL (see docs/SETUP.md) or any webhook (Zapier, Make, Pabbly, n8n).
# REQUIRED in production: without it, forms show an error instead of silently losing leads.
LEADS_WEBHOOK_URL=
# Shared secret included in every payload so your webhook can reject forged requests.
LEADS_WEBHOOK_SECRET=

# ---- Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until you go live.
# Without these, paid programs fall back to their hosted payment link and merch falls back to WhatsApp ordering.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks. Point it at https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Links
# WhatsApp community invite (https://chat.whatsapp.com/...). Shown after registration.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
# Calendly / Cal.com scheduling link for clarity calls. Without it, /book shows a request form.
NEXT_PUBLIC_BOOKING_URL=

# ---- Analytics (optional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# ---- Student accounts (Supabase). Without these, /account runs browser-only DEMO accounts.
# Supabase Dashboard → Project Settings → API. Run supabase/migrations/*.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never prefix with NEXT_PUBLIC_): grants course access after a verified payment.
SUPABASE_SERVICE_ROLE_KEY=
